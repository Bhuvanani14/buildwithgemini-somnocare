# Local development & deployment configuration for SomnoCare v2.0
# Supports both Google AI Studio (GEMINI_API_KEY) and Google Cloud Vertex AI (ADC).

# Option 1: Gemini API Key (Google AI Studio)
# GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-03-fe29ebecbbcc
GOOGLE_CLOUD_LOCATION=global

# Optional: Set SOMNOCARE_FORCE_LOCAL_DB=true to force fast local JSON persistence
# SOMNOCARE_FORCE_LOCAL_DB=false
